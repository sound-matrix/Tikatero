3px;line-height:21px">Organiser</td><td data-id="__react-email-column" style="padding:12px 0 12px 12px;vertical-align:top;color:#2D3142;font-weight:700;font-size:14px;line-height:21px;overflow-wrap:anywhere">Riverfront Live</td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="padding:12px 0;width:36%;vertical-align:top;color:#5C6170;font-size:13px;line-height:21px">Payout reference</td><td data-id="__react-email-column" style="padding:12px 0 12px 12px;vertical-align:top;color:#2D3142;font-weight:700;font-size:14px;line-height:21px;overflow-wrap:anywhere">PO-DEMO-3052</td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="padding:12px 0;width:36%;vertical-align:top;color:#5C6170;font-size:13px;line-height:21px">Payout amount</td><td data-id="__react-email-column" style="padding:12px 0 12px 12px;vertical-align:top;color:#2D3142;font-weight:700;font-size:14px;line-height:21px;overflow-wrap:anywhere">₹1,499 incl. GST</td></tr></tbody></table></td></tr></tbody></table><a href="https://tikatero.example/console" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#F25C54;background-image:linear-gradient(135deg, #F25C54, #FF9F43);color:#FFFFFF;border-radius:10px;padding:16px 22px;font-size:16px;font-weight:700;text-align:center;padding-top:16px;padding-right:22px;padding-bottom:16px;padding-left:22px" target="_blank"><span><!--[if mso]><i style="mso-font-width:366.66666666666663%;mso-text-raise:24px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:12px">Open organiser console</span><span><!--[if mso]><i style="mso-font-width:366.66666666666663%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><hr style="width:100%;border:none;border-color:#E7E8EC;border-top:1px solid #eaeaea;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td style="padding:20px 32px"><p style="font-size:13px;line-height:24px;margin:0;color:#5C6170;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">© Sound Matrix</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "subject": "Your payout has been settled",
  "text": "TIKATERO · BY SOUND MATRIX


YOUR PAYOUT HAS BEEN SETTLED

Hi Alex,

