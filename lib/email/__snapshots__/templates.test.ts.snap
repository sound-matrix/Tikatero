exports[`renders and snapshots account_blocked as branded HTML and plain text 1`] = `
{
  "html": "<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><title>Your Tikatero account is blocked</title></head><body dir="ltr" lang="en" style="background-color:#FFFFFF;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Your Tikatero account is blocked<div> ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿ ‌​‍﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td dir="ltr" lang="en" style="background-color:#FFFFFF;font-family:Arial, Helvetica, sans-serif;color:#2D3142;margin:0;padding:32px 12px"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;border:1px solid #E7E8EC;border-radius:16px;background-color:#FFFFFF;overflow:hidden"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-bottom:1px solid #E7E8EC"><tbody><tr><td style="padding:24px 32px"><img alt="Tikatero" height="48" src="https://tikatero.example/brand/tikatero-email-logo.png" style="display:block;outline:none;border:none;text-decoration:none" width="180"/></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td style="padding:28px 32px 32px"><p style="font-size:12px;line-height:24px;color:#0E9F9A;font-weight:700;letter-spacing:1px;margin:0 0 14px;margin-top:0;margin-right:0;margin-bottom:14px;margin-left:0">TIKATERO · BY SOUND MATRIX</p><h1 style="color:#2D3142;font-size:28px;font-weight:800;line-height:36px;margin:0 0 20px">Your Tikatero account is blocked</h1><p style="font-size:16px;line-height:26px;color:#4A5061;margin:16px 0;margin-top:16px;margin-right:0;margin-bottom:16px;margin-left:0">Hi <!-- -->Alex<!-- -->,</p><p style="font-size:16px;line-height:26px;color:#4A5061;margin:16px 0;margin-top:16px;margin-right:0;margin-bottom:16px;margin-left:0">Your account access has been restricted. Please read the reason below and contact support if you need help.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border:1px solid #E7E8EC;border-radius:10px;margin:24px 0"><tbody><tr><td style="padding:8px 18px"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="padding:12px 0;width:36%;vertical-align:top;color:#5C6170;font-size:13px;line-height:21px">Reason</td><td data-id="__react-email-column" style="padding:12px 0 12px 12px;vertical-align:top;color:#2D3142;font-weight:700;font-size:14px;line-height:21px;overflow-wrap:anywhere">Your account needs a review. Please contact support for help.</td></tr></tbody></table></td></tr></tbody></table><a href="https://tikatero.example/help" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#F25C54;background-image:linear-gradient(135deg, #F25C54, #FF9F43);color:#FFFFFF;border-radius:10px;padding:16px 22px;font-size:16px;font-weight:700;text-align:center;padding-top:16px;padding-right:22px;padding-bottom:16px;padding-left:22px" target="_blank"><span><!--[if mso]><i style="mso-font-width:366.66666666666663%;mso-text-raise:24px" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:12px">Get help</span><span><!--[if mso]><i style="mso-font-width:366.66666666666663%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><hr style="width:100%;border:none;border-color:#E7E8EC;border-top:1px solid #eaeaea;margin:0"/><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td style="padding:20px 32px"><p style="font-size:13px;line-height:24px;margin:0;color:#5C6170;text-align:center;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">© Sound Matrix</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "subject": "Your Tikatero account is blocked",
  "text": "TIKATERO · BY SOUND MATRIX


YOUR TIKATERO ACCOUNT IS BLOCKED

Hi Alex,

Your account access has been restricted. Please read the reason below and contact support if you need help.

ReasonYour account needs a review. Please contact support for help.

Get help https://tikatero.example/help

----------------------------------------

© Sound Matrix",
}
`;

