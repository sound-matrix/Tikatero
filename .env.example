# Copy to .env.local for local development. Leave values empty until a service is wired up.
# Do not put real keys in this file. Do not commit .env.local.

# Public site URL, no trailing slash. Used for metadata. Auth callbacks use the current browser origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public key; legacy ANON_KEY remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cashfree PG: mock (no money), sandbox, production.
# Preview and local dev: empty + no keys selects mock.
# Production selects mock only when PAYMENTS_ALLOW_MOCK=true and CASHFREE_ENV=mock.
# Missing production credentials disable paid checkout. No order or hold is created.
CASHFREE_ENV=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# Checkout security and reconciliation
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Bearer for /api/cron/payments. Do not commit a real value.
CRON_SECRET=
# Root secret for ticket QR codes. At least 32 random characters.
# Set this in Vercel production and preview before payments go live.
# Per-event keys are derived from it. Never commit a real value.
TICKET_QR_SECRET=
# Production mock provider requires true AND CASHFREE_ENV=mock. Mock orders are is_test.
PAYMENTS_ALLOW_MOCK=false

# Resend
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Server-only inbox for the public contact form. Leave empty. Do not commit a real address.
CONTACT_TO_EMAIL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Organiser verification
KYC_MODE=
KYC_NAME_MATCH_THRESHOLD=
CASHFREE_SECURE_ID_CLIENT_ID=
CASHFREE_SECURE_ID_CLIENT_SECRET=
CASHFREE_SECURE_ID_ENV=
